rules_version = '2';

// Regras do Chave Mestra.
// Antes de publicar no Console do Firebase (Firestore Database → Regras),
// troque EMAIL_DO_ADMIN pelo e-mail da conta mestra.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }

    // Conta mestra: e-mail certo e já confirmado (link enviado pelo próprio app).
    function mestre() {
      return logado()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['EMAIL_DO_ADMIN'];
    }

    function dono(uid) { return logado() && request.auth.uid == uid; }

    // Contas comuns só usam o app depois que a conta mestra libera.
    function liberado() {
      return logado() && exists(/databases/$(database)/documents/acesso/$(request.auth.uid));
    }

    // Perfil de cada conta (nome, e-mail, último acesso).
    match /contas/{uid} {
      allow read: if dono(uid) || mestre();
      allow create, update: if (dono(uid) && request.resource.data.email == request.auth.token.email) || mestre();
      allow delete: if mestre();

      // Todos os dados da conta: aluguéis, caixa, fotos…
      match /{colecao}/{doc=**} {
        allow read, write: if (dono(uid) && liberado()) || mestre();
      }
    }

    // Liberação de acesso: só a conta mestra concede ou retira.
    match /acesso/{uid} {
      allow read: if dono(uid) || mestre();
      allow write: if mestre();
    }
  }
}
